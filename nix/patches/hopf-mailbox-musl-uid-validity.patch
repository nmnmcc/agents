+#[cfg(all(target_os = "linux", target_env = "musl"))]
+fn linux_birth_time(path: &Path) -> Option<u64> {
+    use std::{ffi::CString, mem::MaybeUninit, os::unix::ffi::OsStrExt};
+
+    let path = CString::new(path.as_os_str().as_bytes()).ok()?;
+    let mut stat = MaybeUninit::<libc::statx>::zeroed();
+    // SAFETY: path is NUL-terminated and stat points to writable storage
+    // large enough for Linux's statx result.
+    let result = unsafe {
+        libc::syscall(
+            libc::SYS_statx,
+            libc::AT_FDCWD,
+            path.as_ptr(),
+            0 as libc::c_int,
+            libc::STATX_BTIME,
+            stat.as_mut_ptr(),
+        )
+    };
+    if result != 0 {
+        return None;
+    }
+    let stat = unsafe { stat.assume_init() };
+    (stat.stx_mask & libc::STATX_BTIME != 0).then(|| stat.stx_btime.tv_sec.max(0) as u64)
+}
